{
  "name": "kanbone",
  "version": "1.0.0",
  "description": "A lightweight scrum/kanban board built with Backbone.js, TypeScript, and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "analyze": "tsc -b && vite build --mode analyze",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "backbone": "^1.6.1",
    "cash-dom": "^8.1.5",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/backbone": "^1.4.23",
    "@types/underscore": "^1.13.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0"
}
